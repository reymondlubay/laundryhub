# API base URL (required)
VITE_API_BASE_URL=/api

# Local storage namespace (required)
VITE_NAME_PROJECT=laundryhub

# Display name shown in login, sidebar, browser title, and startup screen
VITE_COMPANY_NAME=Laundry Hub

# Logo image path (served from public/ folder)
VITE_COMPANY_LOGO_URL=/company-logo.png
